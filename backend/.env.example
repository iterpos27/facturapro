PORT=5000
NODE_ENV=production

DB_USER=postgres
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=facturapro

# Pool de conexiones — ajustar según RAM del servidor
DB_POOL_MAX=20
DB_POOL_IDLE=30000
DB_POOL_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# JWT — OBLIGATORIO cambiar por clave segura antes de ir a producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_CLAVE_SEGURA_DE_128_CHARS_MINIMO
DATA_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_DE_CIFRADO_INDEPENDIENTE
JWT_EXPIRES_IN=8h

# CORS — Dominio exacto del frontend en producción
CORS_ORIGIN=https://tudominio.com
TRUST_PROXY=true

# Logging — en producción usar warn o error
LOG_LEVEL=warn
PRETTY_LOGS=false
# DB_LOG_SQL=false
BACKUP_MAX_AGE_HOURS=26

# SMTP — requerido para envío automático de comprobantes
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tudominio.com
SMTP_PASS=CAMBIAR_EN_PRODUCCION
SMTP_FROM=FacturaPro <noreply@tudominio.com>
